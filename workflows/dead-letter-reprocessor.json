{
  "connections": {
    "Attempts Remaining?": {
      "main": [
        [
          {
            "index": 0,
            "node": "Reprocess Item",
            "type": "main"
          }
        ],
        [
          {
            "index": 0,
            "node": "Quarantine Item",
            "type": "main"
          }
        ]
      ]
    },
    "Every 15 Minutes": {
      "main": [
        [
          {
            "index": 0,
            "node": "Read Dead Letters",
            "type": "main"
          }
        ]
      ]
    },
    "Quarantine Item": {
      "main": [
        [
          {
            "index": 0,
            "node": "Alert — Quarantined",
            "type": "main"
          }
        ]
      ]
    },
    "Read Dead Letters": {
      "main": [
        [
          {
            "index": 0,
            "node": "Attempts Remaining?",
            "type": "main"
          }
        ]
      ]
    },
    "Reprocess Item": {
      "main": [
        [
          {
            "index": 0,
            "node": "Mark Done",
            "type": "main"
          }
        ],
        [
          {
            "index": 0,
            "node": "Quarantine Item",
            "type": "main"
          }
        ]
      ]
    }
  },
  "name": "Dead-Letter Reprocessor",
  "nodes": [
    {
      "id": "r1-schedule",
      "name": "Every 15 Minutes",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "position": [
        240,
        300
      ],
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1
    },
    {
      "id": "r2-read",
      "name": "Read Dead Letters",
      "parameters": {
        "jsCode": "// Pull pending items from the dead-letter store (oldest first).\n// In production this reads the same store the pipelines write to.\nreturn [{ json: { items: 'pending dead-letter items' } }];"
      },
      "position": [
        460,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "r3-branch",
      "name": "Attempts Remaining?",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-attempts",
              "leftValue": "={{ $json.attempts }}",
              "operator": {
                "operation": "smaller",
                "type": "number"
              },
              "rightValue": 3
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          }
        }
      },
      "position": [
        680,
        300
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2
    },
    {
      "id": "r4-reprocess",
      "maxTries": 3,
      "name": "Reprocess Item",
      "onError": "continueErrorOutput",
      "parameters": {
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "method": "POST",
        "options": {
          "timeout": 10000
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "={{ $json.source === 'lead-intake-pipeline' ? 'https://crm.example.com/api/v1/leads' : 'https://crm.example.com/api/v1/records' }}"
      },
      "position": [
        900,
        220
      ],
      "retryOnFail": true,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "waitBetweenTries": 10000
    },
    {
      "id": "r5-done",
      "name": "Mark Done",
      "parameters": {
        "jsCode": "// The retry worked — mark the item done so it leaves the queue.\n// The audit record stays: who, what, and how many attempts it took.\nreturn [{ json: { id: $json.id, status: 'done' } }];"
      },
      "position": [
        1120,
        220
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "r6-quarantine",
      "name": "Quarantine Item",
      "parameters": {
        "jsCode": "// Poison message: failed 3 requeues. Stop retrying automatically —\n// park it for a human with the full failure history attached.\nreturn [{ json: { id: $json.id, status: 'quarantined', attempts: $json.attempts, lastError: $json.error } }];"
      },
      "position": [
        900,
        460
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "r7-alert",
      "maxTries": 3,
      "name": "Alert — Quarantined",
      "parameters": {
        "channel": "#ops",
        "otherOptions": {},
        "text": "={{ 'POISON MESSAGE quarantined after 3 requeues: ' + $json.id + ' (' + $json.lastError + '). Needs a human.' }}"
      },
      "position": [
        1120,
        460
      ],
      "retryOnFail": true,
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "waitBetweenTries": 5000
    }
  ],
  "pinData": {},
  "settings": {
    "errorWorkflow": "dlq-reprocessor-error-handler",
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "timezone": "America/Los_Angeles"
  },
  "staticData": null
}
