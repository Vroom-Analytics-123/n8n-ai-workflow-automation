{
  "connections": {
    "Dead-letter Record": {
      "main": [
        [
          {
            "index": 0,
            "node": "Sync Summary",
            "type": "main"
          }
        ]
      ]
    },
    "Fetch Stale Records": {
      "main": [
        [
          {
            "index": 0,
            "node": "Loop Records",
            "type": "main"
          }
        ]
      ]
    },
    "Loop Records": {
      "main": [
        [
          {
            "index": 0,
            "node": "Sync Record to CRM",
            "type": "main"
          }
        ]
      ]
    },
    "Midnight Schedule": {
      "main": [
        [
          {
            "index": 0,
            "node": "Fetch Stale Records",
            "type": "main"
          }
        ]
      ]
    },
    "Sync Record to CRM": {
      "main": [
        [
          {
            "index": 0,
            "node": "Loop Records",
            "type": "main"
          }
        ],
        [
          {
            "index": 0,
            "node": "Dead-letter Record",
            "type": "main"
          }
        ]
      ]
    }
  },
  "name": "Nightly CRM Sync",
  "nodes": [
    {
      "id": "s1-schedule",
      "name": "Midnight Schedule",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "position": [
        240,
        300
      ],
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1
    },
    {
      "id": "s2-fetch",
      "maxTries": 3,
      "name": "Fetch Stale Records",
      "parameters": {
        "method": "GET",
        "options": {
          "timeout": 15000
        },
        "url": "https://crm.example.com/api/v1/records?stale=true"
      },
      "position": [
        460,
        300
      ],
      "retryOnFail": true,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "waitBetweenTries": 5000
    },
    {
      "id": "s3-loop",
      "name": "Loop Records",
      "parameters": {
        "batchSize": 25,
        "options": {}
      },
      "position": [
        680,
        300
      ],
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3
    },
    {
      "id": "s4-sync",
      "maxTries": 3,
      "name": "Sync Record to CRM",
      "onError": "continueErrorOutput",
      "parameters": {
        "jsonBody": "={{ JSON.stringify($json) }}",
        "method": "PUT",
        "options": {
          "timeout": 10000
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "={{ 'https://crm.example.com/api/v1/records/' + $json.id }}"
      },
      "position": [
        900,
        300
      ],
      "retryOnFail": true,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "waitBetweenTries": 8000
    },
    {
      "id": "s5-deadletter",
      "name": "Dead-letter Record",
      "parameters": {
        "jsCode": "// A single bad record must not kill the nightly sync.\n// Park it with its id + the error; the reprocessor retries it\n// every 15 minutes and quarantines it after 3 failed requeues.\nconst item = $('Sync Record to CRM').first().json;\nreturn [{ json: { payload: { id: item.id }, error: $json.error?.message ?? 'unknown', source: 'nightly-crm-sync' } }];"
      },
      "position": [
        1120,
        420
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "s6-summary",
      "maxTries": 3,
      "name": "Sync Summary",
      "parameters": {
        "channel": "#ops",
        "otherOptions": {},
        "text": "Nightly CRM sync finished. Dead-lettered records were parked for the reprocessor — check the DLQ dashboard if this fires often."
      },
      "position": [
        1340,
        420
      ],
      "retryOnFail": true,
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "waitBetweenTries": 5000
    }
  ],
  "pinData": {},
  "settings": {
    "errorWorkflow": "nightly-sync-error-handler",
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "timezone": "America/Los_Angeles"
  },
  "staticData": null
}
